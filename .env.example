# Template for .env — copy to .env and fill in real values.
#   cp .env.example .env
# Format: FREQTRADE__<SECTION>__<KEY>  (double underscore = nested config)

# --- Telegram ---
# Token bot 4h (./run_smc.sh). chat_id dùng chung cho mọi bot -> tin nhắn về cùng kênh.
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Token bot 5m scalping (./run_smc_5.sh). PHẢI là bot khác ở @BotFather —
# hai tiến trình dùng chung một token thì Telegram trả 409 Conflict và cả hai đều mất lệnh.
BOT_5M_TG_TOKEN=

# --- Exchange API (live only) ---
# FREQTRADE__EXCHANGE__KEY=
# FREQTRADE__EXCHANGE__SECRET=

# --- REST API ---
# Image bake sẵn password/jwt từ config.json (docs/docker-smc.md §5). Bắt buộc đè khi
# image rời khỏi máy build.
# FREQTRADE__API_SERVER__PASSWORD=
# FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# --- Deploy qua registry (./deploy_smc.sh — chỉ cần trên MÁY BUILD) ---
# SMC_REGISTRY=ghcr.io/<github-username>
# SMC_IMAGE_NAME=freqtrade-smc
# SMC_PLATFORM=linux/amd64
# SMC_REGISTRY_USER=<github-username>
# SMC_REGISTRY_TOKEN=<PAT scope write:packages>

# --- Chỉ cần trên SERVER (docker-compose.smc.deploy.yml) ---
# SMC_IMAGE=ghcr.io/<github-username>/freqtrade-smc:<tag>

